{
  "name": "yata-fetch",
  "version": "3.0.0",
  "packageManager": "pnpm@10.4.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Adds CLI interface for importing translation files from Yata",
  "license": "MIT",
  "main": "./dist/cli.cjs",
  "author": "Dominik Zborowski <dominik.zborowski@gmail.com>",
  "keywords": [
    "yata",
    "translations",
    "i18n",
    "locale",
    "yatapp"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/dzbo/yata-fetch.git"
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "yata-fetch": "./bin/yata-fetch.js"
  },
  "scripts": {
    "build": "vite build",
    "prepare": "husky || true && vite build",
    "generate": "node bin/yata-fetch.js --config test/fixtures/yata.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "npm-run-all --aggregate-output --continue-on-error --parallel \"lint:*\"",
    "lint:eslint": "eslint src test *.config.ts",
    "lint:ts": "tsc --noEmit",
    "lint:fmt": "prettier --check --log-level=warn --write .",
    "release": "bash scripts/release.sh",
    "prepublishOnly": "pnpm lint && pnpm coverage && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "husky": "9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "17.3.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "^8.2.1",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "shell-quote": "1.9.0",
      "brace-expansion": ">=1.1.18"
    }
  },
  "lint-staged": {
    "src/**/*.ts": "eslint",
    "*": "prettier --write --ignore-unknown"
  }
}
